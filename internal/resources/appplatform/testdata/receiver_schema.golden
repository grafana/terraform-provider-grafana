spec.wecom_v1[].title: string, optional, grafana=title
spec.wecom_v1[].to_user: string, optional, grafana=touser
spec.wecom_v1[].uid: string, required, grafana=uid (integration field)
spec.wecom_v1[].url: string, optional, sensitive, grafana=url
